{
  "id": "element_of_day",
  "name": "Element of the Day",
  "version": "0.1.3",
  "description": "Display a periodic table element that changes daily.",
  "author": "FiestaBoard Team",
  "icon": "atom",
  "category": "utility",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--element-of-day",
  "documentation": "README.md",
  "min_refresh_seconds": 3600,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to refresh (once per day is sufficient).",
        "default": 3600,
        "minimum": 3600
      }
    },
    "required": []
  },
  "variables": {
    "groups": {
      "element": {
        "label": "Element"
      }
    },
    "simple": {
      "element_name": {
        "description": "Element name",
        "type": "string",
        "max_length": 15,
        "group": "element",
        "example": "Hydrogen"
      },
      "symbol": {
        "description": "Element symbol",
        "type": "string",
        "max_length": 3,
        "group": "element",
        "example": "H"
      },
      "atomic_number": {
        "description": "Atomic number",
        "type": "integer",
        "max_length": 4,
        "group": "element",
        "example": "1"
      },
      "atomic_weight": {
        "description": "Standard atomic weight",
        "type": "string",
        "max_length": 8,
        "group": "element",
        "example": "1.008"
      },
      "category": {
        "description": "Element category (e.g. nonmetal, noble gas)",
        "type": "string",
        "max_length": 18,
        "group": "element",
        "example": "nonmetal"
      }
    }
  },
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Element of the Day displayed on a Vestaboard",
      "caption": "Example board output using the default template",
      "primary": true
    }
  ],
  "teaser": "H - HYDROGEN",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "  Element of the Day",
        "",
        "     Hydrogen (H)",
        "Atomic No: 1",
        "Weight:    1.008",
        "       nonmetal"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "Hydrogen",
        "SYM H",
        "AT# 1"
      ]
    }
  ],
  "api_docs": "https://pubchemdocs.ncbi.nlm.nih.gov/pug-rest",
  "demo": {
    "flagship": {
      "name": "Element of the Day Demo",
      "config": {
        "enabled": true,
        "refresh_seconds": 3600
      },
      "template": [
        "Element of the Day",
        "",
        "{{element_of_day.element_name}} ({{element_of_day.symbol}})",
        "Atomic No: {{element_of_day.atomic_number}}",
        "Weight:    {{element_of_day.atomic_weight}}",
        "{{element_of_day.category}}"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Element of Day (Note)",
      "template": [
        "{{element_of_day.element_name}}",
        "SYM {{element_of_day.symbol}}",
        "AT# {{element_of_day.atomic_number}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
